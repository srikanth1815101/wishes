[
  {{- range $index, $page := .Pages }}
  {{- if $index }},{{ end }}
  {
    "id": {{ $page.Params.id | default $page.File.TranslationBaseName | jsonify }},
    "name": {{ $page.Title | jsonify }},
    "slug": {{ $page.Params.slug | default (printf "templates/%s" $page.File.TranslationBaseName) | jsonify }},
    "category": {{ $page.Params.category | jsonify }},
    "tagline": {{ $page.Params.tagline | jsonify }},
    "description": {{ $page.Params.description | default $page.Summary | jsonify }},
    "price": {{ $page.Params.price | default 0 }},
    "original_price": {{ $page.Params.original_price | default 99 }},
    "image_url": {{ $page.Params.image_url | jsonify }},
    "gallery": {{ $page.Params.gallery | jsonify }},
    "features": {{ $page.Params.features | jsonify }},
    "tags": {{ $page.Params.tags | jsonify }},
    "is_featured": {{ if $page.Params.is_featured }}true{{ else }}false{{ end }},
    "is_active": {{ if ne $page.Params.is_active false }}true{{ else }}false{{ end }},
    "demand_type": {{ ($page.Params.demand_type | default "all_year") | jsonify }},
    "date": {{ ($page.Date.Format "2006-01-02T15:04:05Z07:00" | default $page.Params.date) | jsonify }}
  }
  {{- end }}
]
